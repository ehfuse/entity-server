{
    "name": "activity_log",
    "description": "read_only 예제 — API를 통한 수정·삭제가 불가하고 서버 내부(훅/SP) 로만 기록되는 감사 로그",
    "read_only": true,
    "license_scope": false,
    "hard_delete": true,
    "history_ttl": 0,
    "index": {
        "actor_seq": {
            "comment": "행위자 user seq (null = 시스템)"
        },
        "entity_name": {
            "comment": "대상 엔티티명",
            "required": true
        },
        "entity_seq": {
            "comment": "대상 레코드 seq"
        },
        "action": {
            "comment": "수행된 작업",
            "type": [
                "INSERT",
                "UPDATE",
                "DELETE",
                "LOGIN",
                "LOGOUT",
                "EXPORT",
                "IMPORT"
            ],
            "required": true
        },
        "ip_address": {
            "comment": "요청 IP",
            "type": "varchar(45)"
        },
        "result_code": {
            "comment": "결과 코드 (HTTP 상태)",
            "type": "int"
        }
    },
    "types": {
        "before_snapshot": "text",
        "after_snapshot": "text",
        "detail": "text"
    },
    "comments": {
        "before_snapshot": "변경 전 데이터 스냅샷 (JSON)",
        "after_snapshot": "변경 후 데이터 스냅샷 (JSON)",
        "detail": "추가 상세 정보"
    }
}
