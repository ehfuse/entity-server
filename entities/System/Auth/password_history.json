{
    "name": "password_history",
    "description": "비밀번호 변경 이력 (재사용 금지 정책용) 사용자 환경에 맞게 fields를 자유롭게 확장할 수 있습니다.",
    "hard_delete": true,
    "fields": {
        "account_seq": {
            "index": true,
            "comment": "계정 seq",
            "type": "integer",
            "required": true
        },
        "passwd_hash": {
            "comment": "변경 시점의 비밀번호 해시 (salt 포함)"
        },
        "changed_time": {
            "comment": "비밀번호 변경 시각"
        }
    }
}
