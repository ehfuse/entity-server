    "hooks": {
        "after_insert": [
            {
                "type": "sql",
                "query": "INSERT INTO account_audit (account_seq, action, email, created_time) VALUES (?, ?, ?, NOW())",
                "params": ["${new.seq}", "INSERT", "${new.email}"],
                "required": true
            }
        ],
        "after_update": [
            {
                "type": "sql",
                "query": "INSERT INTO account_audit (account_seq, action, email, created_time) VALUES (?, ?, ?, NOW())",
                "params": ["${new.seq}", "UPDATE", "${new.email}"],
                "required": true
            }
        ],
        "after_delete": [
            {
                "type": "sql",
                "query": "INSERT INTO account_audit (account_seq, action, email, created_time) VALUES (?, ?, ?, NOW())",
                "params": ["${old.seq}", "DELETE", "${old.email}"],
                "required": true
            }
        ],
        "after_get": [
            {
                "type": "entity",
                "entity": "account_device",
                "action": "list",
                "conditions": {
                    "account_seq": "${new.seq}"
                },
                "assign_to": "devices"
            }
        ]
    }
}
