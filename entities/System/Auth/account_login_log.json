{
    "name": "account_login_log",
    "description": "account_login_log 엔티티.",
    "compress": true,
    "fields": {
        "browser": {
            "index": true,
            "comment": "브라우저"
        },
        "country_code": {
            "index": true,
            "comment": "국가코드 iso2"
        },
        "device_id": {
            "index": true,
            "comment": "디바이스 ID",
            "type": "string"
        },
        "device_type": {
            "index": true,
            "comment": "장치종류"
        },
        "domain": {
            "index": true,
            "comment": "도메인"
        },
        "email": {
            "index": true,
