            "comment": "로그인 이메일"
        },
        "ip_address": {
            "index": true,
            "hash": true,
            "comment": "접속아이피"
        },
        "is_success": {
            "index": true,
            "comment": "성공여부"
        },
        "language": {
            "comment": "언어"
        },
        "account_seq": {
            "index": true,
