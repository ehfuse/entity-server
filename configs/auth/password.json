{
    "password_policy": {
        "min_length": 8,
        "require_mixed_case": false,
        "require_number": false,
        "require_special": false,
        "history_count": 5
    },
    "admin_force_reset": {
        "temp_password_length": 12,
        "require_change": true,
        "notify_email": true
    },
    "password_reset": {
        "enabled": false,
        "token_ttl_sec": 300,
        "base_url": "/password-reset",
        "rate_limit": {
            "per_email_per_hour": 5,
            "per_ip_per_minute": 10
        }
    },
    "email_verification": {
        "enabled": false,
        "required": false,
        "code_length": 6,
        "code_ttl_sec": 300,
        "max_attempts": 5,
        "rate_limit": {
            "per_email_per_hour": 5
        }
    }
}
