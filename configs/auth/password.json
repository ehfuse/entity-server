{
    "password_policy": {
        "min_length": 8,
        "max_length": 128,
        "require_mixed_case": false,
        "require_number": false,
        "require_special": false,
        "history_count": 5,
        "forbidden_patterns": {
            "sequential_digits": true,
            "repeated_chars": true,
            "keyboard_patterns": false,
            "sequential_length": 4
        },
        "pii_check": {
            "enabled": false,
            "entity": "user",
            "fields": ["phone", "birthday"]
        }
    },
    "admin_force_reset": {
        "temp_password_length": 12,
        "require_change": true,
        "notify_email": true
    },
    "password_reset": {
        "enabled": true,
        "temp_password_ttl_sec": 300,
        "temp_password_length": 12,
        "rate_limit": {
            "per_email_per_hour": 5,
            "per_ip_per_minute": 10
        }
    },
    "email_verification": {
        "enabled": true,
        "required": false,
        "code_length": 6,
        "code_ttl_sec": 300,
        "max_attempts": 5,
        "rate_limit": {
            "per_email_per_hour": 5
        }
    }
}
