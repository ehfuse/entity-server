# Entity Server URL
# 비워두면 Vite dev proxy(/v1 -> http://localhost:47200)를 사용합니다.
# 직접 지정하려면 예: VITE_ENTITY_SERVER_URL=http://localhost:47200
# 프로덕션에서는 반드시 설정해야 합니다.
VITE_ENTITY_SERVER_URL=

# 패킷 암호화 magic 바이트 길이
# 서버의 packet_magic_len 설정과 동일해야 합니다 (기본값: 4, 최소: 2)
VITE_ENTITY_SERVER_PACKET_MAGIC_LEN=4
